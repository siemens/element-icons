{
  "name": "@siemens/element-icons",
  "version": "1.4.1",
  "description": "Icon set for the Siemens Element design system.",
  "homepage": "https://github.com/siemens/element-icons#readme",
  "bugs": {
    "url": "https://github.com/siemens/element-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/siemens/element-icons.git"
  },
  "license": "MIT",
  "author": {
    "name": "Siemens",
    "email": "info@siemens.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "prettier": "@siemens/prettier-config",
  "scripts": {
    "build": "node scripts/build.js",
    "codepoints": "node codepoints.js",
    "format": "prettier --log-level warn --write .",
    "lint:format": "prettier --check .",
    "lint:metadata": "node lint-metadata.js",
    "lint": "eslint ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*": {
      "default": "./dist/*"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@siemens/prettier-config": "5.0.0",
    "archiver": "8.0.0",
    "cheerio": "1.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.0",
    "eslint-plugin-headers": "1.3.4",
    "globby": "16.2.4",
    "lodash": "4.18.1",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "semantic-release": "25.0.9",
    "svgo": "4.0.2",
    "svgtofont": "6.5.3"
  }
}
